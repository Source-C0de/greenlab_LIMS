# GreenLabLIMS KSA — frontend environment

# Set to "true" to switch the app from mock-data to the backend.
# Default (unset / "false"): every page reads from src/mock-data/* as before.
VITE_USE_API=false

# Base URL of the backend.
#   - Dev:   leave EMPTY to use the Vite /api proxy (proxied to http://localhost:8000).
#   - Prod:  set to the absolute origin, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=

# Bearer token sent as the Authorization header.
# Leave empty in dev if your backend doesn't require auth on /health.
VITE_API_TOKEN=
