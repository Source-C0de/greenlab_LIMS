# GreenLabLIMS KSA — frontend environment

# Set to "true" to switch the app from mock-data to the backend.
# Default (unset / "false"): the app reads from its mock repositories.
VITE_USE_API=false

# Base URL of the backend.
#   - Dev:   leave EMPTY to use the Vite /api proxy (proxied to http://localhost:8000).
#   - Prod:  set to the absolute origin, e.g. https://api.example.com
#
# The `/api/v1` tenant prefix is added automatically if you omit it, so both
# "https://api.example.com" and "https://api.example.com/api/v1" work. The
# superadmin surface (`/api/superadmin`) is derived from the same value.
VITE_API_BASE_URL=http://localhost:8000

# Bearer token sent as the Authorization header.
# Leave empty in dev — the app obtains its token by logging in.
VITE_API_TOKEN=
